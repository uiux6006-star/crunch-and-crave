# Copy this file to ".env" on the server and fill in the values.
# Never commit or share the real .env file.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=paste-a-long-random-key-here
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com

# Portfolio banner (1 = show "Portfolio demo" bar, 0 = real shop)
DJANGO_DEMO_MODE=1

# Optional — real order emails through Gmail (needs a Google "App password")
# DJANGO_EMAIL_HOST_USER=you@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=abcdefghijklmnop
# DJANGO_ORDER_NOTIFY_EMAILS=you@gmail.com
